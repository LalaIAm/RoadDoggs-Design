{
  "enabled": true,
  "name": "Commit & Push After Task",
  "description": "After every spec task completes, Kiro reviews the changes, writes a detailed commit message, then stages, commits, and pushes to the current branch.",
  "version": "1.0.0",
  "when": {
    "type": "postTaskExecution"
  },
  "then": {
    "type": "askAgent",
    "prompt": "A spec task just completed. Do the following:\n1. Run `git diff --staged` and `git status` to see what changed.\n2. Stage all changes with `git add .`\n3. Write a detailed, conventional-commit-style message that summarizes what was implemented. Include:\n   - A short subject line (type: description, max 72 chars)\n   - A blank line\n   - A bullet-point body describing the key changes (files added/modified, components built, styles added, etc.)\n4. Commit using that message.\n5. Push to the current branch.\nDo not ask for confirmation — just do it."
  }
}
